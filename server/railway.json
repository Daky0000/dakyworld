{
  "$schema": "https://railway.app/railway.schema.json",
  "_comment": "This is the file Railway actually reads, because the service's Root Directory is `server`. `npm run build` here builds server/client first, then the API.",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": "node scripts/migrate-images-to-r2.mjs",
    "preDeployTimeoutSeconds": 300,
    "startCommand": "npm start",
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
