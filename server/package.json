{
  "name": "dakyworld-os-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:client && prisma generate && tsc -p tsconfig.json",
    "build:client": "npm --prefix client ci && npm --prefix client run build",
    "build:server": "prisma generate && tsc -p tsconfig.json",
    "checks": "tsx checks/run.ts",
    "checks:types": "tsc --noEmit -p tsconfig.checks.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "demo:docs": "tsx scripts/demoDocuments.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^5.20.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.1",
    "stripe": "^17.2.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
