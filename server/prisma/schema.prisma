// Dakyworld OS — core data model
// Covers all entities from the "Nine Systems" spec: Lead & Pipeline, Proposal &
// Negotiation, Project & Delivery, Invoicing & Payments, Care Plans & Recurring
// Revenue, Time & Capacity, Financials & Reporting (derived from below), Team &
// Performance, Settings & Integration (env-driven, not modeled here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Team & Permissions
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  OPERATIONS_FINANCE
  CLIENT_VIEWER
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String?  @unique // links to Clerk auth identity; null until first login
  email       String   @unique
  name        String
  role        Role     @default(DEVELOPER)
  skills      String[] @default([])
  hourlyRate  Decimal? @db.Decimal(10, 2)
  weeklyCapacityHours Decimal @default(0) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedProjects ProjectAssignment[]
  assignedTasks    Task[]
  timeEntries      TimeEntry[]
  communications   Communication[]
  performanceNotes PerformanceNote[]
}

model PerformanceNote {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  note      String
  rating    Int? // 1-5, optional quality rating from a client-linked review
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Clients & Contacts
// ---------------------------------------------------------------------------

model Client {
  id             String   @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  address        String?
  sector         String?
  firstContactAt DateTime?
  lifetimeValue  Decimal  @default(0) @db.Decimal(12, 2)
  creditTerms    String? // e.g. "Net 15", "50% deposit"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts       Contact[]
  leads          Lead[]
  proposals      Proposal[]
  projects       Project[]
  carePlans      CarePlan[]
  invoices       Invoice[]
  communications Communication[]
}

model Contact {
  id              String   @id @default(cuid())
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  name            String
  title           String?
  email           String?
  phone           String?
  decisionRole    String? // their role in the buying decision
  isPrimary       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Lead & Pipeline
// ---------------------------------------------------------------------------

enum LeadSource {
  REFERRAL
  LINKEDIN
  COLD_EMAIL
  OUTREACH
  CONTENT
  WARM_NETWORK
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id               String     @id @default(cuid())
  client           Client?    @relation(fields: [clientId], references: [id])
  clientId         String?
  contactName      String
  contactEmail     String?
  contactPhone     String?
  companyName      String?
  source           LeadSource @default(OTHER)
  status           LeadStatus @default(NEW)
  leadScore        Int        @default(0) // 0-100
  discoveryCallAt  DateTime?
  discoveryNotes   String?
  estimatedDealSize Decimal?  @db.Decimal(12, 2)
  winLossReason    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  proposals      Proposal[]
  communications Communication[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Proposal & Negotiation
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  WON
  LOST
}

model Proposal {
  id            String         @id @default(cuid())
  lead          Lead?          @relation(fields: [leadId], references: [id])
  leadId        String?
  client        Client?        @relation(fields: [clientId], references: [id])
  clientId      String?
  title         String
  serviceType   String // e.g. "Website Build", "Care Plan", "Automation"
  scopeSummary  String
  priceAmount   Decimal        @db.Decimal(12, 2)
  priceTier     String? // e.g. "SME Essentials", "Growth", "Enterprise Concierge"
  currency      String         @default("GHS")
  status        ProposalStatus @default(DRAFT)
  sentAt        DateTime?
  viewedAt      DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?
  pdfUrl        String? // Cloudinary URL once generated
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Project & Delivery
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  DELIVERED
  CANCELLED
}

model Project {
  id           String        @id @default(cuid())
  client       Client        @relation(fields: [clientId], references: [id])
  clientId     String
  proposal     Proposal?     @relation(fields: [proposalId], references: [id])
  proposalId   String?       @unique
  name         String
  serviceType  String
  scopeSummary String
  status       ProjectStatus @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  budgetAmount Decimal?      @db.Decimal(12, 2)
  actualHours  Decimal       @default(0) @db.Decimal(8, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments    ProjectAssignment[]
  milestones     Milestone[]
  tasks          Task[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  communications Communication[]
  carePlan       CarePlan?
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id             String     @id @default(cuid())
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  title          String
  description    String?
  assignee       User?      @relation(fields: [assigneeId], references: [id])
  assigneeId     String?
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  estimateHours  Decimal?   @db.Decimal(6, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  timeEntries TimeEntry[]
}

// ---------------------------------------------------------------------------
// Time & Capacity
// ---------------------------------------------------------------------------

model TimeEntry {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  task      Task?    @relation(fields: [taskId], references: [id])
  taskId    String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @default(now())
  hours     Decimal  @db.Decimal(5, 2)
  billable  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Care Plans & Recurring Revenue
// ---------------------------------------------------------------------------

enum CarePlanTier {
  SME_ESSENTIALS
  GROWTH
  ENTERPRISE_CONCIERGE
}

enum CarePlanStatus {
  ACTIVE
  PAUSED
  CHURNED
}

model CarePlan {
  id              String         @id @default(cuid())
  client          Client         @relation(fields: [clientId], references: [id])
  clientId        String
  project         Project?       @relation(fields: [projectId], references: [id])
  projectId       String?        @unique
  tier            CarePlanTier
  monthlyFee      Decimal        @db.Decimal(12, 2)
  currency        String         @default("GHS")
  billingDay      Int            @default(1) // day of month, 1-28
  includedHours   Decimal?       @db.Decimal(6, 2)
  hoursUsedThisCycle Decimal     @default(0) @db.Decimal(6, 2)
  status          CarePlanStatus @default(ACTIVE)
  startedAt       DateTime       @default(now())
  churnedAt       DateTime?
  stripeSubscriptionId String?   @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  invoices Invoice[]
}

// ---------------------------------------------------------------------------
// Invoicing & Payments
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  client         Client        @relation(fields: [clientId], references: [id])
  clientId       String
  project        Project?      @relation(fields: [projectId], references: [id])
  projectId      String?
  carePlan       CarePlan?     @relation(fields: [carePlanId], references: [id])
  carePlanId     String?
  invoiceNumber  String        @unique
  currency       String        @default("GHS")
  amountTotal    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  pdfUrl         String? // Cloudinary URL once generated
  stripePaymentIntentId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// Communications (linked to Lead, Proposal, or Project)
// ---------------------------------------------------------------------------

enum CommunicationType {
  EMAIL
  CALL
  MESSAGE
  MEETING
}

model Communication {
  id        String            @id @default(cuid())
  type      CommunicationType
  summary   String
  outcome   String?
  occurredAt DateTime         @default(now())
  createdAt DateTime          @default(now())

  client   Client?  @relation(fields: [clientId], references: [id])
  clientId String?
  lead     Lead?    @relation(fields: [leadId], references: [id])
  leadId   String?
  project  Project? @relation(fields: [projectId], references: [id])
  projectId String?
  loggedBy User?    @relation(fields: [loggedById], references: [id])
  loggedById String?

  attachments Attachment[]
}

model Attachment {
  id              String        @id @default(cuid())
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  communicationId String
  url             String // Cloudinary URL
  filename        String
  createdAt       DateTime      @default(now())
}
