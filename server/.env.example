# --- Database (Railway: create a Postgres plugin in your project, copy its DATABASE_URL here) ---
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth (Clerk: https://dashboard.clerk.com -> API Keys) ---
# Leave blank to run in DEV_NO_AUTH mode (single implicit Owner user, no real login).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DEV_NO_AUTH=true

# --- Payments (Stripe: https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- File storage (Cloudinary: https://console.cloudinary.com -> Dashboard) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
