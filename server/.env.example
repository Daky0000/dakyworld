# --- Database ---
# Local Docker Postgres (see README "Running it locally"). Production uses
# Railway's own DATABASE_URL, set in the service variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dakyworld_os?schema=public"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth ---
# Creates the first Owner account and keeps its password in step with this
# value on every boot, so a lockout is always recoverable: change it, restart
# (or redeploy), sign in. Because the deploy owns this password, the app
# refuses to let that one account change it from the UI.
#
# Quote the password. An unquoted # starts a comment here, so a value like
# Daky#1 would silently load as "Daky" and login would fail with the password
# you think you set.
OWNER_EMAIL=
OWNER_PASSWORD=""

# Skips login entirely as a single implicit Owner. Local convenience only —
# ignored when NODE_ENV=production, so it cannot disable login on the live app.
DEV_NO_AUTH=true

# --- Lead capture (Apify) ---
# Normally set from inside the app: Capture -> Apify connection. It's stored
# encrypted in the database so the Owner can change lead sources without a
# redeploy. Setting it here instead pins it: the app then shows it as managed
# by the environment and won't let the UI edit it.
APIFY_TOKEN=

# Encryption key for tokens stored in the AppSetting table. If it's blank the
# key is derived from DATABASE_URL, which works but means every stored token
# has to be re-entered if the database URL ever changes. Any long random
# string: `openssl rand -base64 32`.
APP_SECRET=

# Default timezone offered for new scraper schedules.
SCRAPER_TIMEZONE=Africa/Accra

# The two capture limits worth pinning from the deploy rather than the UI,
# because they're the ones that stop a mistake costing money. Everything else
# about how scrapes run — the market searched, run timeout, proxy, per-run
# charge cap, report emails, retention — lives in Settings -> Lead capture.
#
# Runs are refused once the month's Apify spend reaches this. Blank = no ceiling.
APIFY_MONTHLY_BUDGET_USD=
# How many scrapes may run at once. Blank = 2.
APIFY_MAX_CONCURRENT_RUNS=

# --- Sheet import: the AI analyst (https://console.anthropic.com/settings/keys) ---
# Reads an uploaded spreadsheet and works out where each table starts, what
# every column means, and which columns don't fit the fixed lead fields.
# Normally set from inside the app: Settings -> AI analyst. Without it, imports
# fall back to pattern-rule mapping.
ANTHROPIC_API_KEY=

# --- Sheet import: Google Drive (https://console.cloud.google.com/apis/credentials) ---
# An OAuth client of type "Web application", with the Drive API and Google
# Sheets API enabled. Add the redirect URI shown on the Import page to the
# client verbatim. Normally set from inside the app: Settings -> Google Drive;
# only the refresh token (written by the consent redirect) is ever stored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when the app sits behind a proxy that rewrites the host, so the
# redirect URI it derives wouldn't match the one registered with Google.
GOOGLE_REDIRECT_URI=

# The app's own public URL. Used for the Google redirect URI and the Stripe
# webhook URL. Normally set from inside the app: Settings -> General.
# Defaults to the request's own scheme and host.
APP_URL=

# --- Payments (Stripe: https://dashboard.stripe.com/apikeys) ---
# Normally set from inside the app: Settings -> Payments. Setting them here
# pins them, and the Settings panel then refuses to edit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- File storage (Cloudinary: https://console.cloudinary.com -> Dashboard) ---
# Normally set from inside the app: Settings -> File storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ---
# Which path sends: SMTP, or the Hostinger mailbox over its MCP server.
# Leave blank and the app follows whichever was connected last in
# Settings -> Email. Pinning it here also stops the UI switching away from it.
MAIL_TRANSPORT=

# SMTP, for any mailbox that isn't the Hostinger one. Normally set from inside
# the app: Settings -> Email. Google Workspace needs an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# Hostinger Agentic Mail (hPanel -> Emails -> your domain -> Agentic mail ->
# API). The token is the whole configuration — the mailbox it may send from is
# read back from Hostinger — so the other two are only worth setting when you
# want the deploy to pin the mailbox as well. Normally set from inside the app:
# Settings -> Email -> Hostinger.
HOSTINGER_MAIL_TOKEN=
HOSTINGER_MAILBOX_ID=
HOSTINGER_MAILBOX_ADDRESS=

# Only for pointing the client at a stand-in server while testing. Blank uses
# Hostinger's own endpoints.
HOSTINGER_MCP_URL=
HOSTINGER_MAIL_API=
